# ==============================================================================
# SECURITY HARDENING: DISABLE SCRIPT EXECUTION IN UPLOADS DIRECTORY
# ==============================================================================

# Disable directory listing
Options -Indexes -ExecCGI

# Turn off PHP engine if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Remove script execution handlers
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .py .sh .bash .exe .bat .cmd
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .cgi .pl .py .sh .bash .exe .bat .cmd
</IfModule>

# Block all direct requests to script or executable files
<FilesMatch "(?i)\.(php|phtml|php[0-9]|phps|phar|cgi|pl|py|sh|bash|exe|bat|cmd|asp|aspx|jsp|shtml|htm|html)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
